# ---------------------------------------------------------------------------
# TechStore API — variaveis de ambiente
#
# Copie para `.env` (`cp .env.example .env`). O arquivo `.env` NUNCA e versionado.
# Este exemplo existe para que qualquer pessoa saiba QUAIS variaveis existem sem
# precisar descobrir lendo o codigo — e sem que nenhum segredo real entre no Git.
# ---------------------------------------------------------------------------

# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# Prefixo global das rotas. As rotas de negocio ficam em /api/v1/...
API_PREFIX=api

# Origens autorizadas no CORS, separadas por virgula.
# 5173 = vite dev server | 4173 = vite preview (usado pelo Playwright no CI)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Nivel minimo de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Banco de dados -------------------------------------------------------
# Credenciais consumidas pelo container do Postgres no docker-compose
POSTGRES_USER=techstore
POSTGRES_PASSWORD=techstore
POSTGRES_DB=techstore
POSTGRES_PORT=5432

# String de conexao usada pelo Prisma.
# Rodando a API na maquina (npm run start:dev) -> host `localhost`
# Rodando a API no compose                     -> host `db` (nome do servico)
DATABASE_URL=postgresql://techstore:techstore@localhost:5432/techstore?schema=public

# --- Hash de senha --------------------------------------------------------
# Custo do bcrypt. Cada incremento DOBRA o trabalho de quebrar o hash offline —
# e tambem o tempo de cada login. 12 e o padrao de producao; a suite de API pode
# usar 10 para nao gastar minutos de CI hasheando senha.
BCRYPT_ROUNDS=12

# --- Rate limiting --------------------------------------------------------
# Janela em milissegundos e numero maximo de requisicoes por janela.
# O limite e generoso de proposito: um limite baixo reprovaria a suite de
# automacao inteira, que dispara dezenas de requisicoes em paralelo.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# --- Autenticacao ---------------------------------------------------------
# Segredo de assinatura do ACCESS token. Minimo de 32 caracteres — um segredo
# curto e adivinhavel por forca bruta, e quem adivinha assina o proprio token.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=desenvolvimento-apenas-troque-este-segredo-em-producao-por-favor

# Validade do access token, EM SEGUNDOS. Curta de proposito: enquanto ele existe,
# nao ha como revoga-lo (JWT e stateless). 900 s = 15 min e a janela aceita.
#
# Segundos e nao "15m": o formato textual do jsonwebtoken aceita "15m", "15 minutes"
# e tambem "15" (que significa 15 MILISSEGUNDOS, nao minutos). Um numero validado
# como inteiro nao tem essa armadilha.
JWT_ACCESS_TTL_SECONDS=900

# Validade do refresh token, em dias.
#
# Repare que NAO existe JWT_REFRESH_SECRET: o refresh token nao e um JWT. E uma
# string aleatoria opaca, guardada como hash no banco e validada por consulta.
# Um segredo de assinatura so faria sentido se ele precisasse ser autoverificavel,
# e ele nao precisa — o banco e a fonte da verdade sobre a sessao estar viva.
REFRESH_TOKEN_TTL_DAYS=7
